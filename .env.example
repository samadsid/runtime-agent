APP_ENV=development
PAYMENT_PROVIDER=fake
CHECKOUT_ENABLED_PAYMENT_METHODS=["CASH_ON_DELIVERY"]
PUBLIC_ORDER_NUMBER_PREFIX=MU
BUSINESS_TIMEZONE=Asia/Kolkata
CUSTOMER_RETURNING_INACTIVITY_HOURS=24
FAKE_PAYMENT_WEBHOOK_SECRET=replace-with-a-random-development-secret
FAKE_PAYMENT_BASE_URL=http://localhost:8000
PAYMENT_ATTEMPT_TTL_MINUTES=15
PAYMENT_RECONCILIATION_BATCH_SIZE=100
PAYMENT_RECONCILIATION_INTERVAL_SECONDS=30
PAYMENT_WEBHOOK_RATE_LIMIT_PER_MINUTE=30
FAKE_PAYMENT_RATE_LIMIT_PER_MINUTE=10
ALLOW_DEVELOPMENT_CUSTOMER_ID_HEADER=true
WEB_CHAT_ALLOWED_ORIGINS=["http://localhost:5173"]
WHATSAPP_PROVIDER=disabled
WHATSAPP_PROCESSOR_ENABLED=true
WHATSAPP_CUSTOMER_SERVICE_WINDOW_HOURS=24
# Twilio credentials are required only when WHATSAPP_PROVIDER=twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_PUBLIC_BASE_URL=
# Meta credentials are required only when WHATSAPP_PROVIDER=meta_cloud.
META_GRAPH_API_VERSION=v25.0
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_PUBLIC_BASE_URL=
CUSTOMER_NOTIFICATIONS_ENABLED=false
NOTIFICATION_PROCESSOR_ENABLED=true
NOTIFICATION_DEFAULT_LOCALE=en-IN
# When CUSTOMER_NOTIFICATIONS_ENABLED=true with Twilio enabled, provide a JSON
# object containing an approved HX... Content SID for every order type/locale.
TWILIO_NOTIFICATION_CONTENT_SIDS={}
# JSON values contain the approved Meta template name and language code.
META_NOTIFICATION_TEMPLATES={}
